# Copy to .env on the machine. Nothing here is read by a client.
EARS_DOMAIN=ears.example.com
# Static tokens: "name:token,name:token". Names appear in usage.jsonl, tokens never. Make tokens with `openssl rand -hex 24`.
WAMOTION_EARS_TOKENS=
# Optional: a Better Auth server whose session tokens are also accepted (checked at <url>/api/auth/get-session). Leave empty to use static tokens only.
WAMOTION_WEB_URL=
# Limits (defaults shown). MAX_UPLOAD_MB applies to all files of one request.
MAX_UPLOAD_MB=300
MAX_MEDIA_SEC=600
QUEUE_MAX=8
JOB_TIMEOUT_SEC=900
KEEP_INPUT_HOURS=24
